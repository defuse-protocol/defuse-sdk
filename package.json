{
  "name": "@defuse-protocol/defuse-sdk",
  "version": "1.0.0-beta.195",
  "author": "Defuse Protocol",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./config": {
      "import": "./dist/config.js",
      "types": "./dist/config.d.ts"
    },
    "./types": {
      "import": "./dist/types.js",
      "types": "./dist/types.d.ts"
    },
    "./utils": {
      "import": "./dist/utils.js",
      "types": "./dist/utils.d.ts"
    },
    "./dist/*": {
      "import": "./dist/*.js",
      "types": "./dist/*.d.ts"
    }
  },
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "src",
    "rollup.config.js",
    "tailwind.config.js",
    "tsconfig.json"
  ],
  "scripts": {
    "test": "vitest --passWithNoTests",
    "coverage": "vitest run --coverage",
    "build": "rollup -c && tsc && yarn copy:types",
    "build:watch": "concurrently 'rollup -c -w' 'tsc -w' 'yarn copy:types'",
    "copy:types": "mkdir -p dist && rsync -avm --include='*/' --include='*.d.ts' --exclude='*' src/ dist/",
    "typecheck": "tsc --noEmit --emitDeclarationOnly false",
    "check": "biome check",
    "format": "biome format --write src/",
    "prepare": "husky && ./scripts/gen-defuse-types.sh"
  },
  "dependencies": {
    "@defuse-protocol/bridge-sdk": "^0.6.0",
    "@lifeomic/attempt": "^3.1.0",
    "@noble/curves": "1.4.0",
    "@noble/hashes": "^1.7.1",
    "@peculiar/asn1-ecc": "^2.3.15",
    "@peculiar/asn1-schema": "^2.3.15",
    "@phosphor-icons/react": "^2.1.7",
    "@radix-ui/react-accordion": "^1.0.0",
    "@radix-ui/react-checkbox": "^1.0.0",
    "@radix-ui/react-dialog": "^1.0.0",
    "@radix-ui/react-icons": "^1.0.0",
    "@radix-ui/react-popover": "^1.0.0",
    "@radix-ui/react-select": "^2.0.0",
    "@radix-ui/react-separator": "^1.0.0",
    "@radix-ui/react-slot": "^1.0.0",
    "@radix-ui/react-toast": "^1.0.0",
    "@radix-ui/themes": "^3.0.0",
    "@scure/base": "^1.1.9",
    "@solana/spl-token": "^0.4.9",
    "@solana/web3.js": "^1.95.4",
    "@tanstack/query-core": "^5.59.16",
    "@tanstack/react-query": "^5.59.16",
    "@thames/monads": "^0.7.0",
    "@ton/ton": "^15.3.0",
    "@xstate/react": "^4.1.3",
    "@xstate/store": "^3.0.1",
    "axios": "^1.0.0",
    "borsher": "^3.5.0",
    "clsx": "^2.1.1",
    "near-api-js": "^5.1.1",
    "qrcode.react": "^4.0.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": ">=7.52.1 <7.55.0",
    "react-shadow": "^20.5.0",
    "ripple-address-codec": "^5.0.0",
    "tailwind-merge": "^3.0.1",
    "tailwindcss-animate": "^1.0.7",
    "tweetnacl": "^1.0.3",
    "valibot": "^1.0.0-rc.1",
    "viem": "^2.18.1",
    "xstate": "^5.18.2",
    "zustand": "^5.0.0-rc.2"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.3",
    "@commitlint/cli": "^19.3.0",
    "@commitlint/config-conventional": "^19.2.2",
    "@rollup/plugin-alias": "^5.1.1",
    "@rollup/plugin-json": "^6.1.0",
    "@rollup/plugin-typescript": "^12.1.0",
    "@semantic-release/commit-analyzer": "^13.0.0",
    "@semantic-release/git": "^10.0.1",
    "@semantic-release/github": "^10.1.1",
    "@semantic-release/npm": "^12.0.1",
    "@semantic-release/release-notes-generator": "^14.0.1",
    "@tailwindcss/forms": "^0.5.9",
    "@tailwindcss/typography": "^0.5.15",
    "@tanstack/react-query-devtools": "^5.59.16",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitest/coverage-v8": "2.1.2",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.2",
    "conventional-changelog-conventionalcommits": "^8.0.0",
    "husky": "^9.1.1",
    "lint-staged": "^15.2.10",
    "postcss": "^8.4.47",
    "postcss-import": "^15.1.0",
    "rollup": "^4.22.5",
    "rollup-plugin-postcss": "^4.0.2",
    "semantic-release": "^24.0.0",
    "tailwindcss": "^3.4.13",
    "tsc-alias": "^1.8.10",
    "typescript": "~5.4.2",
    "vitest": "2.1.2"
  },
  "lint-staged": {
    "*.{ts,tsx,js}": [
      "yarn biome check --write"
    ]
  },
  "engines": {
    "node": "^20.13.1"
  },
  "resolutions": {
    "use-sync-external-store": "^1.2.0",
    "near-api-js": "^5.1.1"
  },
  "publishConfig": {
    "access": "public"
  }
}
